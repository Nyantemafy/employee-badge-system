# Copy to .env and edit the values or set environment variables directly
# If DATABASE_URL is set, it overrides individual PG* vars
DATABASE_URL=

# Or configure individually
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=employee_badge

# Set to true if your provider requires SSL (e.g., some managed Postgres)
PGSSL=false

# Server port
PORT=3000
